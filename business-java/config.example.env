# 复制为 business-java/.env，本地密钥和 .env 已在 .gitignore 中忽略。
# Java 商品缓存；TTL 另加最多20%抖动。多个业务库共享 Redis 时使用不同前缀。
# 默认通过启动脚本复用 agent/.env 的 REDIS_URL（包括密码）。需要覆盖时取消注释。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# BUSINESS_REDIS_DATABASE=0
# REDIS_SSL=false
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_CACHE_PREFIX=cloudagent:business:catalog:v1:
# 本地应用配置加密主密钥；与数据库备份分开保管，文件不入库。
# APPLICATION_KEY_FILE=D:/secure/application-secret.key
# 公网部署使用精确HTTPS来源；替换后不再默认信任localhost，多个入口用逗号分隔。
# PLATFORM_ALLOWED_ORIGINS=https://your-platform.example.com
# PLATFORM_SECURE_COOKIE=true

# 只启用支付宝沙箱；管理员还需在 P1 渠道页面设为 SANDBOX。
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_SELLER_ID=
# 应用私钥 PKCS8、支付宝公钥（不是应用公钥）的本地绝对路径。
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=

# 阿里云只开放 ECS DryRun，无收费资源创建。建议使用最小权限 RAM 账号。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 默认演示环境 LOCAL；外部邮件改为 SMTP，外部短信改为 ALIYUN_SMS。
P1_DELIVERY_MODE=LOCAL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 短信模板必须已审核并分别使用 code / content 参数。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_CODE_TEMPLATE_CODE=
ALIYUN_SMS_NOTICE_TEMPLATE_CODE=
