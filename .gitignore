# 本地运行数据、数据库、凭据、备份和下载的工具均放在这里。
/runtime/

# 本机使用的服务器运维 skill，不随项目上传。
/skills/ecs-project-ops/

# Python 虚拟环境、字节码、构建和测试缓存。
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Java / Maven 构建输出；保留 pom.xml、资源文件、迁移 SQL 和 Maven Wrapper。
target/
*.class
*.hprof
hs_err_pid*
replay_pid*

# React / Vue 依赖与构建缓存；package-lock.json 等依赖锁文件应提交。
node_modules/
.vite/
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE 本机配置；这些规则也适用于子项目。
.idea/
*.iml
*.ipr
*.iws

# 环境配置及其备份不能提交；无真实凭据的示例模板可以提交。
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
!*.example.env
!*.sample.env
!*.template.env

# 密钥与私有密钥库。
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# 日志、操作系统文件及编辑器临时文件。
*.log
*.log.*
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp
*.swo
*~
