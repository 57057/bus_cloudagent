{
    email {$ACME_EMAIL}
}
{$PLATFORM_DOMAIN} {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    @runner path /internal/runner/*
    handle @runner {
        reverse_proxy business:5000
    }
    @private path /internal /internal/* /docs /docs/* /openapi.json
    handle @private {
        respond 404
    }
    @api path /api /api/* /health
    handle @api {
        reverse_proxy business:5000 {
            flush_interval -1
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
